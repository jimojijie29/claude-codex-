+# yfinance releases before this one are blocked by Yahoo's TLS fingerprinting
+# and report a permanent "Too Many Requests" regardless of request volume.
+_YFINANCE_MIN_UNTHROTTLED = (0, 2, 58)
+
+
+def _is_rate_limit_error(exc: BaseException) -> bool:
+    """Return True when ``exc`` is Yahoo throttling rather than a real outage."""
+    if type(exc).__name__ == "YFRateLimitError":
+        return True
+    text = str(exc).lower()
+    return "too many requests" in text or "rate limit" in text or "429" in text
+
+
+def _yfinance_version_tuple() -> Optional[tuple]:
+    """Return the installed yfinance version as an int tuple, if parseable."""
+    try:
+        from importlib.metadata import version
+
+        parts = []
+        for piece in version("yfinance").split(".")[:3]:
+            digits = "".join(ch for ch in piece if ch.isdigit())
+            if not digits:
+                break
+            parts.append(int(digits))
+        return tuple(parts) if parts else None
+    except Exception:
+        return None
+
+
+def _rate_limit_message() -> str:
+    """Build the rate-limit message, with an upgrade hint for old yfinance."""
+    installed = _yfinance_version_tuple()
+    if installed is not None and installed < _YFINANCE_MIN_UNTHROTTLED:
+        current = ".".join(str(part) for part in installed)
+        return f"rate limited by Yahoo; yfinance {current} is outdated - run `pip install -U yfinance`"
+    return "rate limited by Yahoo (temporary, retried on demand)"
+
+
 def _check_yfinance() -> CheckResult:
     """Check yfinance availability."""
     try:
@@ -223,6 +261,15 @@ def _check_yfinance() -> CheckResult:
             return CheckResult(name="yfinance", status="ready", message="reachable", impact="")
         return CheckResult(name="yfinance", status="ready", message="reachable (no price data)", impact="")
     except Exception as exc:
+        if _is_rate_limit_error(exc):
+            # Yahoo answered, so the source is reachable; the throttle is
+            # temporary and backtests fall back to other loaders meanwhile.
+            return CheckResult(
+                name="yfinance",
+                status="degraded",
+                message=_rate_limit_message(),
+                impact="US/HK equity data falls back to akshare until Yahoo lifts the limit",
+            )
         return CheckResult(
             name="yfinance",
             status="error",
@@ -286,6 +333,7 @@ def _check_ccxt() -> CheckResult:

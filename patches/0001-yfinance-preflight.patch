diff --git a/agent/tests/test_preflight.py b/agent/tests/test_preflight.py
index 75b923a..6b3e9ad 100644
--- a/agent/tests/test_preflight.py
+++ b/agent/tests/test_preflight.py
@@ -26,3 +26,77 @@ def test_akshare_check_skips_when_missing(monkeypatch) -> None:
 
     assert result.status == "skipped"
     assert result.message == "package not installed"
+
+
+class YFRateLimitError(Exception):
+    """Stand-in for yfinance's rate-limit exception (matched by name)."""
+
+
+def _install_fake_yfinance(monkeypatch, exc: Exception) -> None:
+    import types
+
+    class _Ticker:
+        def __init__(self, symbol: str) -> None:
+            self.symbol = symbol
+
+        @property
+        def fast_info(self):
+            raise exc
+
+    fake = types.ModuleType("yfinance")
+    fake.Ticker = _Ticker
+    monkeypatch.setitem(sys.modules, "yfinance", fake)
+
+
+def test_yfinance_rate_limit_is_degraded_not_failed(monkeypatch) -> None:
+    """A Yahoo throttle is temporary; it must not be reported as a failure."""
+    _install_fake_yfinance(monkeypatch, YFRateLimitError("Too Many Requests. Rate limited. Try after a while."))
+    monkeypatch.setattr(preflight, "_yfinance_version_tuple", lambda: (0, 2, 66))
+
+    result = preflight._check_yfinance()
+
+    assert result.status == "degraded"
+    assert "rate limited" in result.message
+    assert "pip install" not in result.message
+    assert not result.critical
+
+
+def test_yfinance_rate_limit_suggests_upgrade_for_old_version(monkeypatch) -> None:
+    _install_fake_yfinance(monkeypatch, YFRateLimitError("Too Many Requests. Rate limited. Try after a while."))
+    monkeypatch.setattr(preflight, "_yfinance_version_tuple", lambda: (0, 2, 54))
+
+    result = preflight._check_yfinance()
+
+    assert result.status == "degraded"
+    assert "yfinance 0.2.54 is outdated" in result.message
+    assert "pip install -U yfinance" in result.message
+
+
+def test_yfinance_other_errors_still_fail(monkeypatch) -> None:
+    _install_fake_yfinance(monkeypatch, ConnectionError("network unreachable"))
+
+    result = preflight._check_yfinance()
+
+    assert result.status == "error"
+    assert "ConnectionError" in result.message
+
+
+def test_run_preflight_renders_degraded_status(monkeypatch) -> None:
+    from rich.console import Console
+
+    degraded = preflight.CheckResult(
+        name="yfinance", status="degraded", message="rate limited by Yahoo", impact="falls back to akshare"
+    )
+    ready = preflight.CheckResult(name="LLM", status="ready", message="ok", impact="")
+    for fn_name in ("_check_llm_provider", "_check_okx", "_check_tushare", "_check_akshare", "_check_ccxt"):
+        monkeypatch.setattr(preflight, fn_name, lambda: ready)
+    monkeypatch.setattr(preflight, "_check_yfinance", lambda: degraded)
+
+    console = Console(record=True, width=200)
+    results = preflight.run_preflight(console)
+    output = console.export_text()
+
+    assert degraded in results
+    assert "WARN" in output
+    assert "FAIL" not in output
+    assert "falls back to akshare" in output
